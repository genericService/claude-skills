{
  "name": "Acme Service Agent",
  "description": "Answers structured capability queries and scopes project engagements.",
  "version": "1.0.0",
  "supportedInterfaces": [
    {
      "url": "https://acme.com/api/a2a/jsonrpc",
      "protocolBinding": "JSONRPC",
      "protocolVersion": "1.0"
    },
    {
      "url": "https://acme.com/api/a2a",
      "protocolBinding": "HTTP+JSON",
      "protocolVersion": "1.0"
    }
  ],
  "provider": {
    "organization": "Acme Corp",
    "url": "https://acme.com"
  },
  "capabilities": {
    "streaming": true,
    "pushNotifications": false,
    "extendedAgentCard": false
  },
  "defaultInputModes": ["text/plain", "application/json"],
  "defaultOutputModes": ["text/markdown", "application/json"],
  "skills": [
    {
      "id": "service-inquiry",
      "name": "Service Capability & Pricing Lookup",
      "description": "Returns structured scope, timeline, and fee bands for standard offerings.",
      "tags": ["services", "pricing", "scoping"],
      "examples": ["What is included in a baseline infrastructure health check?"]
    }
  ]
}
